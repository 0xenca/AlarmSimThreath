# Configuración de arranque de AlarmSim (requiere reinicio)
DATABASE_URL=sqlite:///./data/alarmsim.db
# Clave de firma de sesiones (el instalador genera una aleatoria)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Pedir usuario y contraseña en la web (false = acceso libre, solo en redes de laboratorio)
AUTH_ENABLED=true
# Receptor DC-09 de pruebas integrado, TCP+UDP (0 = desactivado)
TEST_RECEIVER_HOST=0.0.0.0
TEST_RECEIVER_PORT=7100
LOG_LEVEL=INFO
