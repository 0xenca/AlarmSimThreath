# Configuración de arranque de AlarmHub (requiere reinicio del servicio)
# Base de datos: SQLite por defecto. Para gran volumen se recomienda PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://alarmhub:CLAVE@localhost/alarmhub
DATABASE_URL=sqlite:///./data/alarmhub.db
# Clave para firmar las sesiones web (el instalador genera una aleatoria)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Interfaz web
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Receptores
RECEIVERS_ENABLED=true
DC09_HOST=0.0.0.0
DC09_TCP_PORT=7000
DC09_UDP_PORT=7000
# Sur-Gard MLR2 / Contact ID sobre TCP (0 = desactivado)
SURGARD_PORT=0
# Poner a true si se publica detrás de HTTPS (proxy inverso)
SECURE_COOKIES=false
LOG_LEVEL=INFO
